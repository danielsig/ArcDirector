{
	"name": "@arc-director/mcp",
	"author": "Daniel Sigurdsson",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prebuild": "tsc -b ../control ../arc-director",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "tsc -p tsconfig.json && node ../scripts/node-test.mjs",
		"start": "node dist/server.js"
	},
	"dependencies": {
		"@arc-director/control": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.25.2",
		"arc-director": "workspace:*",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"typescript": "^6.0.3"
	}
}
