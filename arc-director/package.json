{
	"name": "arc-director",
	"author": "Daniel Sigurdsson",
	"private": false,
	"version": "0.6.0",
	"license": "MIT",
	"description": "Library that lets NPCs think, plan, and act in games, powered by local LLMs.",
	"repository": {
		"type": "git",
		"url": "https://github.com/danielsig/ArcDirector.git",
		"directory": "arc-director"
	},
	"keywords": [
		"game",
		"ai",
		"npc",
		"thinking",
		"planning",
		"acting",
		"llm",
		"system one",
		"local"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./bench": {
			"types": "./dist/bench/index.d.ts",
			"import": "./dist/bench/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/scripts",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "tsc -p tsconfig.json && node ../scripts/node-test.mjs",
		"bench": "tsc -p tsconfig.json && node dist/bench/cli.js",
		"demo": "tsc -p tsconfig.json && node dist/scripts/fake-host.js",
		"fixture": "tsc -p tsconfig.json && node dist/scripts/fixture-go-to.js",
		"prepublishOnly": "pnpm build"
	},
	"peerDependencies": {
		"@wllama/wllama": "^3.8.1"
	},
	"peerDependenciesMeta": {
		"@wllama/wllama": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@wllama/wllama": "3.8.1",
		"typescript": "^6.0.3"
	},
	"homepage": "https://arcdirector.com",
	"bugs": {
		"url": "https://github.com/danielsig/ArcDirector/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
