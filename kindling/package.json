{
	"name": "@arc-director/kindling",
	"author": "Daniel Sigurdsson",
	"private": false,
	"version": "0.5.0",
	"license": "MIT",
	"description": "Simple 3D engine for building games, powered by Three.js.",
	"repository": {
		"type": "git",
		"url": "https://github.com/danielsig/ArcDirector.git",
		"directory": "kindling"
	},
	"keywords": [
		"three.js",
		"arc-director",
		"3d",
		"game",
		"engine",
		"unity-like"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./score": {
			"types": "./dist/score/index.d.ts",
			"import": "./dist/score/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/scripts",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "tsc -p tsconfig.json && node --test --test-reporter spec dist/core/Component.test.js dist/core/Transform.test.js dist/core/Game.test.js dist/core/physics.test.js dist/core/save.test.js dist/core/ChunkStreamer.test.js dist/assets/move.test.js dist/render/shader.test.js dist/render/meshKit.test.js dist/audio/Audio.test.js dist/audio/speech.test.js dist/score/score.test.js",
		"dev": "vite --config playground/vite.config.ts",
		"prepublishOnly": "pnpm build"
	},
	"devDependencies": {
		"@gltf-transform/core": "^4.5.1",
		"@gltf-transform/functions": "^4.5.1",
		"@types/node": "^20.19.43",
		"@types/three": "^0.185.4",
		"sharp": "^0.35.5",
		"three": "^0.185.1",
		"typescript": "^6.0.3",
		"vite": "^8.2.1"
	},
	"homepage": "https://github.com/danielsig/ArcDirector/tree/master/kindling",
	"bugs": {
		"url": "https://github.com/danielsig/ArcDirector/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"three": "^0.185.1"
	}
}
