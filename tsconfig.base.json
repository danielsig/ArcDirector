{
	"compilerOptions": {
		"strict": true,
		"target": "ES2021",
		"noImplicitOverride": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": false,
		"forceConsistentCasingInFileNames": true

		// Moved out of the old root tsconfig — those assumed a single Node package:
		// "module": "CommonJS",
		// "moduleResolution": "node",
		// "declaration": true,
		// "declarationMap": true,
		// "rootDir": "src",
		// "outDir": "dist"
		// game/ uses module ESNext + moduleResolution bundler (Vite).
		// arc-director/ uses ESNext + declarations for the library emit.
	}
}
