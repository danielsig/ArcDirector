{
	"name": "@arc-director/game",
	"author": "Daniel Sigurdsson",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"predev": "tsc -p ../arc-director/tsconfig.json && tsc -p ../kindling/tsconfig.json && tsc -p ../control/tsconfig.json",
		"prebuild": "tsc -p ../arc-director/tsconfig.json && tsc -p ../kindling/tsconfig.json && tsc -p ../control/tsconfig.json",
		"pretypecheck": "tsc -p ../arc-director/tsconfig.json && tsc -p ../kindling/tsconfig.json && tsc -p ../control/tsconfig.json",
		"build": "vue-tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "vue-tsc --noEmit",
		"test": "node --experimental-strip-types --test src/prefs.test.ts src/ui/bindings.test.ts && node scripts/viteTest.mjs src/characters/CharacterMotor.test.ts src/world/path.test.ts src/world/dressing.test.ts src/engine/autoShadows.test.ts"
	},
	"dependencies": {
		"@arc-director/control": "workspace:*",
		"@arc-director/kindling": "workspace:*",
		"arc-director": "workspace:*",
		"three": "^0.185.1",
		"vue": "^3.5.41"
	},
	"devDependencies": {
		"@types/three": "^0.185.4",
		"@vitejs/plugin-vue": "^6.0.8",
		"pngjs": "^7.0.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vue-tsc": "^3.3.10"
	}
}
